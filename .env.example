# Supabase public values. Leave empty to run the local demo catalog.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# Server-only values. Never prefix secrets with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# 행정안전부 도로명주소 검색 API 승인키. 서버에서만 사용한다.
JUSO_API_KEY=

# 관리자 로그인 ID에 @가 없을 때 붙일 도메인. 미설정 시 dealkey.co.kr.
ADMIN_LOGIN_EMAIL_DOMAIN=dealkey.co.kr

# Business defaults are intentionally configurable and are snapshotted per order.
L1_COMMISSION_RATE=0.08
L2_COMMISSION_RATE=0.03
COMMISSION_APPROVAL_DAYS=7
PAYMENT_WEBHOOK_SECRET=

# 코페이 인증결제. MKEY는 서버 전용 비밀값이라 NEXT_PUBLIC_ 접두사를 붙이면 안 된다.
# 붙이는 순간 브라우저 번들에 들어가고, 누구나 결제 요청을 위조할 수 있다.
# 두 값이 비어 있으면 주문 API가 503을 돌려주고 주문 자체를 만들지 않는다
# (만들어두면 재고만 잡히고 결제는 못 하는 주문이 남는다).
KORPAY_MERCHANT_ID=
KORPAY_MKEY=
KORPAY_BASE_URL=https://payments.korpay.com/v1

# 개발 중에도 데모 폴백을 끄고 싶을 때 1로 설정한다.
# production(NODE_ENV=production)에서는 어차피 데모 모드가 비활성화된다.
CC_DISABLE_DEMO=
