{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    ".env",
    ".env.local",
    "eslint.config.mjs",
    "tsconfig.json"
  ],
  "globalEnv": [
    "NODE_ENV",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
    "NEXT_PUBLIC_WEB_URL",
    "ADMIN_LOGIN_EMAIL_DOMAIN",
    "SUPABASE_SERVICE_ROLE_KEY",
    "PAYDATAKR_PUBLIC_KEY",
    "PAYDATAKR_PAY_KEY",
    "PAYDATAKR_API_BASE_URL",
    "PAYDATAKR_RECEIPT_BASE_URL",
    "JUSO_API_KEY",
    "L1_COMMISSION_RATE",
    "L2_COMMISSION_RATE",
    "COMMISSION_APPROVAL_DAYS",
    "CC_DISABLE_DEMO"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "dist/**"
      ],
      "env": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_WEB_URL",
        "ADMIN_LOGIN_EMAIL_DOMAIN",
        "SUPABASE_SERVICE_ROLE_KEY",
        "PAYDATAKR_PUBLIC_KEY",
        "PAYDATAKR_PAY_KEY",
        "PAYDATAKR_API_BASE_URL",
        "PAYDATAKR_RECEIPT_BASE_URL",
        "JUSO_API_KEY",
        "L1_COMMISSION_RATE",
        "L2_COMMISSION_RATE",
        "COMMISSION_APPROVAL_DAYS",
        "CC_DISABLE_DEMO"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck",
        "build"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
