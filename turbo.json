{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [".env", ".env.local"],
  "globalEnv": ["NODE_ENV", "NEXT_PUBLIC_SUPABASE_URL", "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY", "NEXT_PUBLIC_WEB_URL", "ADMIN_LOGIN_EMAIL_DOMAIN", "SUPABASE_SERVICE_ROLE_KEY", "PAYMENT_WEBHOOK_SECRET"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"],
      "env": ["NEXT_PUBLIC_SUPABASE_URL", "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY", "NEXT_PUBLIC_WEB_URL", "ADMIN_LOGIN_EMAIL_DOMAIN", "SUPABASE_SERVICE_ROLE_KEY", "PAYMENT_WEBHOOK_SECRET"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
